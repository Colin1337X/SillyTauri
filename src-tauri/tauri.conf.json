{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "SillyTauri",
  "version": "1.18.0",
  "identifier": "com.sillytauri.app",
  "build": {
    "frontendDist": "./dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "SillyTauri",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../server.js",
      "../src/**/*",
      "../public/**/*",
      "../default/**/*",
      "../plugins.js",
      "../package.json"
    ],
    "externalBin": [],
    "linux": {
      "deb": {
        "depends": ["nodejs (>= 20)"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "node",
          "cmd": "node",
          "args": true
        }
      ]
    },
    "fs": {
      "scope": {
        "allow": ["$APPDATA/**", "$RESOURCE/**", "$TEMP/**"],
        "deny": []
      }
    },
    "dialog": {
      "open": true,
      "save": false
    }
  }
}
